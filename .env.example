# Optional shared runner override for scripts/check-ui.sh.
# Export this in the shell; the script does not load .env files.
IOS_UI_RUNNER=

# App Store Connect API team key for scripts/release.sh and scripts/asc.py (Admin role, needed for cloud signing).
# scripts/release.sh loads these from .env; keep the .p8 file outside the repository.
ASC_KEY_ID=
ASC_ISSUER_ID=
# Defaults to ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
ASC_KEY_PATH=
