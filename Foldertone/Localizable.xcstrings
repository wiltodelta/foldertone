    "This removes the source and its unshared tracks from Foldertone. Original files stay in Files." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى إزالة المصدر ومقاطعه غير المشتركة مع مصادر أخرى من Foldertone. تبقى الملفات الأصلية في الملفات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Източникът и записите, които не са общи с други източници, ще бъдат премахнати от Foldertone. Оригиналните файлове остават във Файлове."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এতে Foldertone থেকে উৎসটি এবং অন্য উৎসের সাথে শেয়ার না হওয়া এর ট্র্যাকগুলো সরানো হবে। মূল ফাইলগুলো ফাইল অ্যাপেই থাকবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’eliminaran de Foldertone la font i les pistes que no comparteix amb altres fonts. Els fitxers originals es queden a Fitxers."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdroj a jeho skladby, které nesdílí s jinými zdroji, budou z Foldertone odstraněny. Původní soubory zůstanou v Souborech."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilden og de numre, som ikke deles med andre kilder, fjernes fra Foldertone. De originale filer bliver i Filer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden die Quelle und ihre nur dort enthaltenen Titel aus Foldertone entfernt. Die Originaldateien bleiben in „Dateien“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πηγή και τα κομμάτια της που δεν ανήκουν και σε άλλες πηγές αφαιρούνται από το Foldertone. Τα αρχικά αρχεία μένουν στα Αρχεία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán de Foldertone la fuente y las pistas que no compartan otras fuentes. Los archivos originales se quedan en Archivos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán de Foldertone la fuente y las pistas que no compartan otras fuentes. Los archivos originales permanecen en Archivos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä poistaa lähteen ja sen jakamattomat raidat Foldertone-sovelluksesta. Alkuperäiset tiedostot jäävät Tiedostoihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime la source et ses pistes non partagées de Foldertone. Les fichiers d’origine restent dans Fichiers."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime la source et ses pistes non partagées de Foldertone. Les fichiers originaux restent dans Fichiers."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ Foldertoneમાંથી સ્રોત અને તેના શેર ન કરેલા ટ્રેક દૂર કરે છે. મૂળ ફાઇલો ફાઇલ્સમાં જ રહે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פעולה זו מסירה מ־Foldertone את המקור ואת הרצועות שלו שאינן משותפות. הקבצים המקוריים נשארים ב״קבצים״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे स्रोत और उसके असाझा ट्रैक Foldertone से हट जाते हैं। मूल फ़ाइलें फ़ाइलें ऐप में बनी रहती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time se izvor i njegovi nedijeljeni zapisi uklanjaju iz aplikacije Foldertone. Izvorne datoteke ostaju u Datotekama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezzel a forrás és a nem megosztott számai törlődnek a Foldertone appból. Az eredeti fájlok a Fájlokban maradnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini menghapus sumber dan trek yang tidak dibagikan dari Foldertone. File asli tetap di File."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sorgente e le sue tracce non condivise verranno rimosse da Foldertone. I file originali restano in File."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソースと、ほかのソースと共有されていないトラックがFoldertoneから削除されます。元のファイルは「ファイル」に残ります。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бұл әрекет дереккөзді және оның ортақ емес тректерін Foldertone ішінен өшіреді. Бастапқы файлдар «Файлдар» ішінде қалады."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇದು ಮೂಲವನ್ನು ಮತ್ತು ಅದರ ಹಂಚಿಕೊಳ್ಳದ ಟ್ರ್ಯಾಕ್‌ಗಳನ್ನು Foldertone ನಿಂದ ತೆಗೆದುಹಾಕುತ್ತದೆ. ಮೂಲ ಫೈಲ್‌ಗಳು ಫೈಲ್‌ಗಳು ಆ್ಯಪ್‌ನಲ್ಲಿ ಉಳಿಯುತ್ತವೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foldertone에서 이 소스와 공유되지 않은 트랙이 제거됩니다. 원본 파일은 파일 앱에 남아 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šaltinis ir jo nebendrinami takeliai bus pašalinti iš Foldertone. Originalūs failai lieka programoje „Failai“."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇത് ഉറവിടത്തെയും പങ്കിടാത്ത അതിന്റെ ട്രാക്കുകളെയും Foldertone-ൽ നിന്ന് നീക്കം ചെയ്യും. യഥാർത്ഥ ഫയലുകൾ ഫയലുകൾ ആപ്പിൽ തുടരും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हे Foldertone मधून स्रोत आणि त्याचे शेअर न केलेले ट्रॅक काढून टाकते. मूळ फाइल्स फाइल्स ॲपमध्ये राहतात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan ini mengeluarkan sumber dan lagunya yang tidak dikongsi daripada Foldertone. Fail asal kekal dalam Fail."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette fjerner kilden og sporene den ikke deler med andre kilder, fra Foldertone. Originalfilene blir liggende i Filer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee verwijder je de bron en de niet-gedeelde nummers ervan uit Foldertone. Oorspronkelijke bestanden blijven in Bestanden staan."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହା Foldertone ରୁ ଉତ୍ସ ଏବଂ ଏହାର ଅଣ-ସେୟାର୍ ହୋଇଥିବା ଟ୍ରାକଗୁଡ଼ିକୁ ହଟାଇଦିଏ। ମୂଳ ଫାଇଲଗୁଡ଼ିକ ଫାଇଲ୍‌ସରେ ରହେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਹ ਸਰੋਤ ਅਤੇ ਉਸ ਦੇ ਗੈਰ-ਸਾਂਝੇ ਟਰੈਕਾਂ ਨੂੰ Foldertone ਵਿੱਚੋਂ ਹਟਾ ਦਿੰਦਾ ਹੈ। ਮੂਲ ਫ਼ਾਈਲਾਂ ਫ਼ਾਈਲਾਂ ਐਪ ਵਿੱਚ ਹੀ ਰਹਿੰਦੀਆਂ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Źródło i jego utwory, których nie ma w innych źródłach, zostaną usunięte z Foldertone. Oryginalne pliki pozostaną w aplikacji Pliki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove a fonte e as faixas exclusivas dela do Foldertone. Os arquivos originais continuam no app Arquivos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto remove a fonte e as respetivas faixas não partilhadas do Foldertone. Os ficheiros originais mantêm-se na app Ficheiros."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sursa și piesele sale care nu apar în alte surse vor fi eliminate din Foldertone. Fișierele originale rămân în Fișiere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Источник и его треки, которых нет в других источниках, будут удалены из Foldertone. Оригинальные файлы останутся в Файлах."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdroj a jeho skladby, ktoré nie sú v iných zdrojoch, sa odstránia z Foldertone. Pôvodné súbory zostanú v Súboroch."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S tem odstranite vir in njegove skladbe, ki niso v drugih virih, iz Foldertone. Izvirne datoteke ostanejo v Datotekah."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här tar bort källan och dess spår som inte delas med andra källor från Foldertone. Originalfilerna ligger kvar i Filer."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இது மூலத்தையும் பகிரப்படாத அதன் டிராக்குகளையும் Foldertone இலிருந்து அகற்றும். அசல் ஃபைல்கள் ஃபைல்களில் இருக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇది సోర్స్‌ను, షేర్ చేయని దాని ట్రాక్‌లను Foldertone నుండి తీసివేస్తుంది. అసలు ఫైల్‌లు ఫైల్స్‌లోనే ఉంటాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การดำเนินการนี้จะเอาแหล่งที่มาและแทร็กที่ไม่ได้ใช้ร่วมกันออกจาก Foldertone ไฟล์ต้นฉบับยังคงอยู่ในแอปไฟล์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem, kaynağı ve paylaşılmayan parçalarını Foldertone’dan kaldırır. Orijinal dosyalar Dosyalar’da kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Джерело та його треки, яких немає в інших джерелах, буде вилучено з Foldertone. Оригінальні файли залишаться у «Файлах»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس سے ذریعہ اور اس کے غیر مشترکہ ٹریکس Foldertone سے ہٹ جاتے ہیں۔ اصل فائلز، فائلز میں رہتی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này xóa nguồn và các bài hát không dùng chung của nguồn khỏi Foldertone. Các tệp gốc vẫn nằm trong Tệp."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會從 Foldertone 移除此來源及其未共用的曲目。原始檔案仍會保留在「檔案」中。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会从 Foldertone 中移除该来源及其未共用的曲目。原始文件仍保留在“文件”中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會從 Foldertone 移除此來源及其未共用的曲目。原始檔案仍會保留在「檔案」中。"
          }
        }
      }
