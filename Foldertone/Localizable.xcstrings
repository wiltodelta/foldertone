    "Saved sources could not be read. Add your files or folders again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذرت قراءة المصادر المحفوظة. أضف ملفاتك أو مجلداتك مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запазените източници не могат да се прочетат. Добавете файловете или папките си отново."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংরক্ষিত উৎসগুলো পড়া যায়নি। আপনার ফাইল বা ফোল্ডারগুলো আবার যোগ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’han pogut llegir les fonts desades. Torna a afegir els fitxers o les carpetes."
