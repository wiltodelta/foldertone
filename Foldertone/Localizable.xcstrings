        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les chansons que vous supprimez de « %@ » apparaissent ici."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમે %@માંથી દૂર કરો છો તે ગીતો અહીં દેખાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שירים שיוסרו מ־%@ יופיעו כאן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ से हटाए गए गीत यहाँ दिखाई देते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
