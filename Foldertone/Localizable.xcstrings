        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo cambia el nombre en Foldertone. La carpeta o el archivo mantiene su nombre en Archivos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimi muuttuu vain Foldertone-sovelluksessa. Kansio tai tiedosto säilyttää nimensä Tiedostoissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul le nom dans Foldertone change. Le dossier ou le fichier garde son nom dans Fichiers."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul le nom dans Foldertone change. Le dossier ou le fichier conserve son nom dans Fichiers."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ફક્ત Foldertoneમાંનું નામ બદલાય છે. ફાઇલ્સમાં ફોલ્ડર અથવા ફાઇલનું નામ એ જ રહે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רק השם ב־Foldertone משתנה. התיקייה או הקובץ שומרים על שמם ב״קבצים״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ Foldertone में नाम बदलता है। फ़ाइलें ऐप में फ़ोल्डर या फ़ाइल का नाम वही रहता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mijenja se samo naziv u aplikaciji Foldertone. Mapa ili datoteka zadržava svoj naziv u Datotekama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak a név változik a Foldertone appban. A mappa vagy fájl megtartja a nevét a Fájlokban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya nama di Foldertone yang berubah. Folder atau file tetap memakai namanya di File."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia solo il nome in Foldertone. La cartella o il file mantiene il suo nome in File."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更されるのはFoldertone内の名前だけです。「ファイル」でのフォルダやファイルの名前は変わりません。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тек Foldertone ішіндегі аты өзгереді. Қалта не файл «Файлдар» ішінде өз атын сақтайды."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foldertone ನಲ್ಲಿನ ಹೆಸರು ಮಾತ್ರ ಬದಲಾಗುತ್ತದೆ. ಫೈಲ್‌ಗಳು ಆ್ಯಪ್‌ನಲ್ಲಿ ಫೋಲ್ಡರ್ ಅಥವಾ ಫೈಲ್ ತನ್ನ ಹೆಸರನ್ನು ಉಳಿಸಿಕೊಳ್ಳುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foldertone에서의 이름만 변경됩니다. 파일 앱의 폴더나 파일 이름은 그대로 유지됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasikeičia tik pavadinimas programoje Foldertone. Programoje „Failai“ aplankas ar failas išlaiko savo pavadinimą."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foldertone-ലെ പേര് മാത്രമേ മാറൂ. ഫയലുകൾ ആപ്പിൽ ഫോൾഡറിന്റെയോ ഫയലിന്റെയോ പേര് മാറില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फक्त Foldertone मधील नाव बदलते. फाइल्स ॲपमध्ये फोल्डर किंवा फाइलचे नाव तसेच राहते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya nama dalam Foldertone yang berubah. Folder atau fail itu mengekalkan namanya dalam Fail."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare navnet i Foldertone endres. Mappen eller filen beholder navnet sitt i Filer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen de naam in Foldertone verandert. De map of het bestand behoudt zijn naam in Bestanden."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କେବଳ Foldertone ଭିତରେ ନାମ ବଦଳେ। ଫାଇଲ୍‌ସରେ ଫୋଲ୍ଡର କିମ୍ବା ଫାଇଲର ନାମ ସେହିପରି ରହେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸਿਰਫ਼ Foldertone ਵਿੱਚ ਨਾਮ ਬਦਲਦਾ ਹੈ। ਫ਼ਾਈਲਾਂ ਐਪ ਵਿੱਚ ਫੋਲਡਰ ਜਾਂ ਫ਼ਾਈਲ ਦਾ ਨਾਮ ਉਹੀ ਰਹਿੰਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nazwa zmienia się tylko w Foldertone. Folder lub plik zachowuje swoją nazwę w aplikacji Pliki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só o nome no Foldertone muda. A pasta ou o arquivo mantém o nome no app Arquivos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só muda o nome no Foldertone. A pasta ou o ficheiro mantém o nome na app Ficheiros."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doar numele din Foldertone se schimbă. Dosarul sau fișierul își păstrează numele în Fișiere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя меняется только в Foldertone. В Файлах папка или файл сохранят прежнее имя."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
