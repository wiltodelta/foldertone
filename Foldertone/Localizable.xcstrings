        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ থেকে আপনি যে গানগুলো সরান সেগুলো এখানে দেখা যায়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí apareixen les cançons que eliminis de %@."
