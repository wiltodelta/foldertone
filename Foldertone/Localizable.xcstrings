    "Only the name in Foldertone changes. The folder or file keeps its name in Files." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتغير الاسم في Foldertone فقط. يحتفظ المجلد أو الملف باسمه في الملفات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Променя се само името във Foldertone. Папката или файлът запазва името си във Файлове."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধু Foldertone-এ নাম পরিবর্তন হয়। ফাইল অ্যাপে ফোল্ডার বা ফাইলের নাম একই থাকে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només canvia el nom a Foldertone. La carpeta o el fitxer manté el nom a Fitxers."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Změní se jen název ve Foldertone. Složka nebo soubor si v Souborech ponechá svůj název."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun navnet i Foldertone ændres. Mappen eller filen beholder sit navn i Filer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur der Name in Foldertone ändert sich. Der Ordner bzw. die Datei behält den Namen in „Dateien“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
