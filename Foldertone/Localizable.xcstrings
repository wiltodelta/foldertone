        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler as fontes guardadas. Adicione novamente os ficheiros ou pastas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sursele salvate nu au putut fi citite. Adaugă din nou fișierele sau dosarele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать сохраненные источники. Добавьте файлы или папки снова."
