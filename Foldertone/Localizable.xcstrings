    "Sync could not be saved. Pull to retry." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر حفظ المزامنة. اسحب لأسفل لإعادة المحاولة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизирането не може да се запази. Плъзнете надолу, за да опитате пак."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সিঙ্ক সংরক্ষণ করা যায়নি। আবার চেষ্টা করতে নিচে টানুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’ha pogut desar la sincronització. Llisca cap avall per tornar-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizaci nelze uložit. Potažením dolů to zkuste znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkroniseringen kunne ikke gemmes. Træk ned for at prøve igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisierung konnte nicht gesichert werden. Zum erneuten Versuchen nach unten ziehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η αποθήκευση του συγχρονισμού. Σύρετε προς τα κάτω για νέα δοκιμή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido guardar la sincronización. Desliza hacia abajo para reintentarlo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar la sincronización. Desliza hacia abajo para volver a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
