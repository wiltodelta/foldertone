        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સેવ કરેલા સ્રોત વાંચી શકાયા નથી. તમારી ફાઇલો અથવા ફોલ્ડર ફરીથી ઉમેરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה לקרוא את המקורות השמורים. יש להוסיף שוב את הקבצים או התיקיות."
