        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಹಾಡನ್ನು ಪ್ಲೇಪಟ್ಟಿ ಮತ್ತು “ಎಲ್ಲಾ ಸಂಗೀತ”ಕ್ಕೆ ಮರಳಿ ತರಲು ಅದನ್ನು ಮರುಸ್ಥಾಪಿಸಿ. ಅದರ ಫೈಲ್ ಫೈಲ್‌ಗಳು ಆ್ಯಪ್‌ನಲ್ಲಿ ಉಳಿಯುತ್ತದೆ."
