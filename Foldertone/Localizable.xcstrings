        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ನಿಂದ ನೀವು ತೆಗೆದುಹಾಕುವ ಹಾಡುಗಳು ಇಲ್ಲಿ ಕಾಣಿಸುತ್ತವೆ."
