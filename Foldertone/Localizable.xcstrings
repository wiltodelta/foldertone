        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сақталған дереккөздерді оқу мүмкін болмады. Файлдарыңызды не қалталарыңызды қайта қосыңыз."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಉಳಿಸಿದ ಮೂಲಗಳನ್ನು ಓದಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ನಿಮ್ಮ ಫೈಲ್‌ಗಳು ಅಥವಾ ಫೋಲ್ಡರ್‌ಗಳನ್ನು ಮತ್ತೆ ಸೇರಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 소스를 읽을 수 없습니다. 파일이나 폴더를 다시 추가하십시오."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepavyko nuskaityti įrašytų šaltinių. Pridėkite failus arba aplankus iš naujo."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സംരക്ഷിച്ച ഉറവിടങ്ങൾ വായിക്കാനായില്ല. നിങ്ങളുടെ ഫയലുകളോ ഫോൾഡറുകളോ വീണ്ടും ചേർക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेव्ह केलेले स्रोत वाचता आले नाहीत. तुमच्या फाइल्स किंवा फोल्डर्स पुन्हा जोडा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sumber yang disimpan tidak dapat dibaca. Tambahkan fail atau folder anda sekali lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke lese lagrede kilder. Legg til filene eller mappene på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaarde bronnen kunnen niet worden gelezen. Voeg je bestanden of mappen opnieuw toe."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସେଭ୍ ହୋଇଥିବା ଉତ୍ସଗୁଡ଼ିକ ପଢ଼ିହେଲା ନାହିଁ। ଆପଣଙ୍କ ଫାଇଲ୍ କିମ୍ବା ଫୋଲ୍ଡର ପୁଣି ଯୋଗ କରନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਰੱਖਿਅਤ ਕੀਤੇ ਸਰੋਤ ਪੜ੍ਹੇ ਨਹੀਂ ਜਾ ਸਕੇ। ਆਪਣੀਆਂ ਫ਼ਾਈਲਾਂ ਜਾਂ ਫੋਲਡਰ ਦੁਬਾਰਾ ਸ਼ਾਮਲ ਕਰੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można odczytać zachowanych źródeł. Dodaj ponownie pliki lub foldery."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler as fontes salvas. Adicione seus arquivos ou pastas novamente."
