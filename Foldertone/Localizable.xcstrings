        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่สามารถอ่านแหล่งที่มาที่บันทึกไว้ได้ โปรดเพิ่มไฟล์หรือโฟลเดอร์ของคุณอีกครั้ง"
